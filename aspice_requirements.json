  {
    "req_id": "SYS.2-BMS-004",
    "asil": "ASIL-D",
    "title": "Thermal Runaway Mitigation under CAN Bus Communication Loss",
    "description": "The BMS shall isolate the high-voltage main contactors within 50ms and trigger active coolant flooding if cell temperature exceeds 65.0 °C concurrently with a loss of CAN bus heartbeat (communication timeout > 100ms).",
    "parameters": {
      "metric": "temperature_and_can_status",
      "threshold_value": "temp > 65.0 and can_active == False",
      "comparison": "and",
      "expected_fault": "ERR_CRITICAL_THERMAL_CAN_FAULT",
      "expected_contactor_state": false
    },
    "scenarios": [
      {
        "name": "nominal_conditions",
        "input_temp": 45.0,
        "can_active": true,
        "expected_state": "NORMAL",
        "expected_contactor": true,
        "expected_fault": null
      },
      {
        "name": "high_temp_with_can_active",
        "input_temp": 66.0,
        "can_active": true,
        "expected_state": "FAULT_SHUTDOWN",
        "expected_contactor": false,
        "expected_fault": "ERR_OVERTEMP_CRITICAL"
      },
      {
        "name": "critical_thermal_can_loss",
        "input_temp": 66.0,
        "can_active": false,
        "expected_state": "FAULT_SHUTDOWN",
        "expected_contactor": false,
        "expected_fault": "ERR_CRITICAL_THERMAL_CAN_FAULT"
      }
    ]
  }
