[
  {
    "req_id": "SYS.2-BMS-001",
    "asil": "ASIL-D",
    "title": "Cell Over-Temperature Isolation",
    "description": "The BMS ECU shall open main contactors and set fault code ERR_OVERTEMP_CRITICAL if cell temperature exceeds 60.0 degrees C.",
    "parameters": {
      "metric": "temperature",
      "threshold_value": 60.0,
      "comparison": ">",
      "expected_fault": "ERR_OVERTEMP_CRITICAL",
      "expected_contactor_state": false
    },
    "scenarios": [
      {
        "name": "nominal_safe_temperature",
        "input_temp": 45.0,
        "expected_state": "NORMAL",
        "expected_contactor": true,
        "expected_fault": null
      },
      {
        "name": "boundary_exact_threshold",
        "input_temp": 60.0,
        "expected_state": "NORMAL",
        "expected_contactor": true,
        "expected_fault": null
      },
      {
        "name": "fault_over_temperature",
        "input_temp": 61.0,
        "expected_state": "FAULT_SHUTDOWN",
        "expected_contactor": false,
        "expected_fault": "ERR_OVERTEMP_CRITICAL"
      }
    ]
  },
